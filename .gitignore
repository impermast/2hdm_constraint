# ⛔ Игнорируем Python-кэш и временные файлы
__pycache__/
*.py[cod]
*.so
*.pyo
*.pyd

# ⛔ Игнорируем виртуальное окружение (venv)
venv/
env/
**/.venv
**/.env
.virtualenv/

# ⛔ Игнорируем конфиденциальные файлы и токены
*.env
secrets.yaml
*.key
*.pem

# ⛔ Игнорируем логи и отладочную информацию
*.log
*.out
*.err
debug.log
logs/

# ⛔ Игнорируем файлы IDE и редакторов
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# ⛔ Игнорируем файлы Cline и AI ассистентов
.cline/
.clinerules
.copilot/
.cursor/
.continue/
.windsurf/

# ⛔ Игнорируем графики (регенерируются)
ZZZ_ZWW/graphs/
ZZZ_ZWW/subgraphs/
ZZZ_ZWW/backfiles/
code_screenshots/

# ⛔ Игнорируем файлы Jupyter Notebook output
.ipynb_checkpoints/

# ⛔ Игнорируем большие устанавливаемые файлы LHAPDF и LoopTools
setup/lhapdf_install/
setup/LHAPDF-6.5.4/
setup/wolfram/

# ⛔ Буферные файлы Mathematica (.mx) — большие, пересчитываются
ZZZ_ZWW/buffer/*.mx

# ⛔ Кэш Python PDF утилит (генерируется из LHAPDF)
modules/pdfcode/xPDF.mx
modules/pdfcode/pdf_mathematica_test.mx
modules/pdfcode/pdf_*.csv

# ⛔ Временные файлы Wolfram Script
*.tmp
*.temp

# ⛔ Файлы операционной системы
.DS_Store
Thumbs.db



